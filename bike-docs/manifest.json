      "Title": "Bicycle.Physics.BodyPose",
      "Summary": "<p sourcefile=\"api/Bicycle.Physics.BodyPose.yml\" sourcestartlinenumber=\"1\">World-space pose and velocity of a single rigid body.</p>\n"
    },
    {
      "type": "ManagedReference",
      "source_relative_path": "api/Bicycle.Physics.ControlInputs.yml",
